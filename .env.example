# Supabase público (requerido)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alternativa heredada a NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase administrativo del lado del servidor
SUPABASE_SECRET_KEY=

# Alternativa heredada a SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=

# Códigos privados de registro
REGISTER_ACCESS_CODE=
PROFESSIONAL_REGISTER_ACCESS_CODE=

# Límites opcionales de PDF en bytes (10 MiB)
RESOURCE_PDF_MAX_SIZE_BYTES=10485760
NUTRITION_PDF_MAX_SIZE_BYTES=10485760
